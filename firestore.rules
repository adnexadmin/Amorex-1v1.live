rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Users Collection: Private user profiles, wallet balances, and account data
    // Authenticated users have read and write permissions for user records
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // User Locations Collection: Real-time private coordinates
    match /userLocations/{userId} {
      allow read, write: if request.auth != null;
    }

    // Unique Username Registry: Lookup index for handle uniqueness
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

